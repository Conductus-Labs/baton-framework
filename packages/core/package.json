{
  "name": "@conductus-labs/baton-core",
  "version": "1.0.0",
  "description": "Baton Framework core types, utilities, and validation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "npx tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "clean": "rm -rf dist",
    "postinstall": "node scripts/setup-baton-folder.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "js-yaml": "^4.1.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3",
    "vitest": "^1.6.1",
    "@vitest/coverage-v8": "^1.6.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "baton",
    "framework",
    "ai",
    "agent",
    "types",
    "validation"
  ],
  "author": "Conductus Labs Ltd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Conductus-Labs/baton-framework.git",
    "directory": "packages/core"
  }
}
