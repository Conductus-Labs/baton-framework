{
  "name": "@conductus-labs/baton-cli",
  "version": "0.1.1",
  "description": "CLI tool for initializing and managing Baton Framework projects",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "baton": "./bin/baton.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "npm link && tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "baton",
    "cli",
    "ai",
    "agent",
    "framework"
  ],
  "author": "Conductus Labs Ltd",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "commander": "^11.1.0",
    "inquirer": "^9.2.15"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.10.0",
    "@vitest/coverage-v8": "^1.6.1",
    "typescript": "^5.3.3",
    "vitest": "^1.6.1"
  },
  "files": [
    "bin",
    "dist",
    "src/config",
    "src/core"
  ]
}
